      "icon": "🗺️"
    },
    "has_registered_business": {
      "type": "bool",
      "scope": "household",
      "icon": "🏭"
    },
    "has_eshram_card": {
      "type": "bool",
      "scope": "member",
      "icon": "🪪"
    },
    "has_job_card": {
      "type": "bool",
      "scope": "household",
      "icon": "⛏️"
    },
    "pays_income_tax": {
      "type": "bool",
      "scope": "member",
      "icon": "🧮"
    },
    "has_formal_pension_cover": {
      "type": "bool",
      "scope": "member",
      "icon": "🗂️"
    },
    "personal_income_over_15000": {
      "type": "bool",
      "scope": "member",
