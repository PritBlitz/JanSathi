{
  "name": "jansathi",
  "private": true,
  "type": "module",
  "description": "Multilingual, voice-first navigator for Indian government schemes. Root tooling for content, rules and checks (no dependencies); the React app lives in frontend/ with its own package.json.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "npm --prefix frontend ci",
    "dev": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "build:web:api": "npm --prefix frontend run build:api",
    "start": "npm run build:web && node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "start:backend": "node tools/gradle.mjs bootRun",
    "build:jar": "npm run build:web:api && node tools/gradle.mjs bootJar",
    "test:backend": "node tools/gradle.mjs test",
    "test": "node --test tools/test-rules.mjs tools/test-lint.mjs",
    "smoke": "npm run build:web && node tools/smoke-web.mjs",
    "build": "node tools/build-bundle.mjs && node tools/build-bundle.mjs --include-drafts",
    "lint:copy": "node tools/lint-copy.mjs",
    "check:locales": "node tools/check-locales.mjs",
    "validate": "node tools/validate-content.mjs",
    "check": "npm run validate && npm run lint:copy && npm run check:locales && npm run check:bundle && npm test",
    "check:bundle": "node tools/build-bundle.mjs --check && node tools/build-bundle.mjs --include-drafts --check",
    "recheck": "python ingest/recheck.py"
  }
}
