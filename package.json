{
  "name": "jansathi",
  "private": true,
  "type": "module",
  "description": "Multilingual, voice-first navigator for Indian government schemes. Tooling for content, rules and the static PWA. No runtime dependencies.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "start:backend": "cd backend && gradlew bootRun",
    "test:backend": "cd backend && gradlew test",
    "test": "node --test tools/test-rules.mjs tools/test-lint.mjs",
    "smoke": "node tools/smoke-web.mjs",
    "build": "node tools/build-bundle.mjs && node tools/build-bundle.mjs --include-drafts",
    "lint:copy": "node tools/lint-copy.mjs",
    "check:locales": "node tools/check-locales.mjs",
    "validate": "node tools/validate-content.mjs",
    "check": "npm run validate && npm run lint:copy && npm run check:locales && npm run check:bundle && npm test",
    "check:bundle": "node tools/build-bundle.mjs --check && node tools/build-bundle.mjs --include-drafts --check",
    "recheck": "python ingest/recheck.py",
    "serve": "node tools/serve.mjs"
  }
}
