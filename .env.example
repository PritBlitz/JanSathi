# Copy to .env (never commit .env). docker compose reads it; for `npm run start:backend`,
# export these variables in your shell instead.

# PostgreSQL password for docker compose.
POSTGRES_PASSWORD=change-me

# Long random secret (e.g. `openssl rand -base64 48`). Keys phone hashes and encrypts saved
# answers, conversations and notes. Keep it: changing it makes saved accounts unreadable.
JANSATHI_SECRET=

# Admin API (/api/v1/admin/*: report moderation, registering helpers). Blank = switched off.
JANSATHI_ADMIN_TOKEN=

# Sign-in codes. "dev" shows the code on screen instead of sending an SMS (testing only).
JANSATHI_SMS_PROVIDER=dev

# The AI (Saathi and the assistant). Google Gemini through its OpenAI-compatible endpoint:
#   1. Create an API key at https://aistudio.google.com/ (Get API key).
#   2. Pick a current Gemini model id from the AI Studio model list (a Flash model is fast and cheap).
JANSATHI_LLM_PROVIDER=openai-compatible
JANSATHI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
JANSATHI_LLM_API_KEY=
JANSATHI_LLM_MODEL=
