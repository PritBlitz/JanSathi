# Copy to .env (never commit .env). docker compose reads it; for `npm run start:backend`,
# export these variables in your shell instead.

# Production switch. docker compose treats a missing value as true: the app then refuses to start
# with the dev SMS sender, a short secret or drafts on. false only on your own machine.
JANSATHI_PRODUCTION=false

# PostgreSQL for docker compose: the owner (migrations) and the API's own role, which owns nothing.
POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me-too

# Long random secret (e.g. `openssl rand -base64 48`). Keys phone hashes and encrypts saved
# answers, conversations and notes. At least 32 characters in production. Never just change it:
# rotate it (docs/OPERATIONS.md section 6), or saved accounts become unreadable.
JANSATHI_SECRET=
# Only during a rotation: the old secret, still readable.
JANSATHI_SECRET_PREVIOUS=

# Bootstrap for the admin API: acts as an admin, to create the first staff accounts. Remove it once
# they exist (people then sign in at #/admin). Blank with no staff account = admin API off.
JANSATHI_ADMIN_TOKEN=

# Sign-in codes. "dev" shows the code on screen instead of sending an SMS (testing only; a production
# start refuses it). "msg91" or "twilio" send real SMS: needs a DLT registration in India.
JANSATHI_SMS_PROVIDER=dev
# MSG91: the template ids of its flows, each tied to a DLT template, and the account key.
# Twilio: templates are registered with Twilio; set any value in the two reminder ids to turn SMS
# reminders on. docs/OPERATIONS.md section 5 has the exact words to register.
JANSATHI_SMS_OTP_TEMPLATE_ID=
JANSATHI_SMS_CHECKLIST_TEMPLATE_ID=
JANSATHI_SMS_DEADLINE_TEMPLATE_ID=
JANSATHI_SMS_MSG91_AUTH_KEY=
JANSATHI_SMS_TWILIO_ACCOUNT_SID=
JANSATHI_SMS_TWILIO_AUTH_TOKEN=
JANSATHI_SMS_TWILIO_MESSAGING_SERVICE_SID=

# The app's address, without a trailing slash, for the link in reminder messages.
JANSATHI_PUBLIC_URL=

# Telegram reminders. All three, or off. Bot from BotFather; webhook set as in OPERATIONS section 5.
JANSATHI_TELEGRAM_BOT_TOKEN=
JANSATHI_TELEGRAM_BOT_USERNAME=
JANSATHI_TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API reminders. All four, or off. Templates must be approved by Meta first.
# Languages: the codes the templates are approved in, comma separated.
JANSATHI_WHATSAPP_ACCESS_TOKEN=
JANSATHI_WHATSAPP_PHONE_NUMBER_ID=
JANSATHI_WHATSAPP_CHECKLIST_TEMPLATE=
JANSATHI_WHATSAPP_DEADLINE_TEMPLATE=
JANSATHI_WHATSAPP_LANGUAGES=en

# Domain for Caddy (docker compose --profile tls). Certificates come from Let's Encrypt.
JANSATHI_DOMAIN=
# Address the app's port binds to on the host. Leave it on this machine.
JANSATHI_BIND=127.0.0.1
# Our own proxies, addresses or CIDR ranges. X-Forwarded-For is believed only from these.
# docker compose defaults to Docker's private ranges; outside compose, blank = ignore the header.
JANSATHI_TRUSTED_PROXIES=172.16.0.0/12
JANSATHI_RATE_LIMIT_ENABLED=true

# Bearer token for /actuator/prometheus. Blank = metrics endpoint off.
JANSATHI_METRICS_TOKEN=
# Sentry-compatible error reports, scrubbed of personal numbers. Blank = off.
JANSATHI_SENTRY_DSN=
JANSATHI_ENVIRONMENT=production

# Web Push reminders for unfinished checklists. Blank = switched off.
# Make a key pair once with `npx web-push generate-vapid-keys`; changing it ends every subscription.
# The subject is a mailto: or https: contact the push services can reach.
JANSATHI_PUSH_PUBLIC_KEY=
JANSATHI_PUSH_PRIVATE_KEY=
JANSATHI_PUSH_SUBJECT=

# Semantic retrieval through the internal ML service (ml/README.md). none = keywords only.
# Recommended in production: ml-service. It beat keywords on the held-out evaluation (eval/README.md),
# and retrieval goes back to keywords by itself if the service is down.
JANSATHI_EMBED_PROVIDER=none
JANSATHI_EMBED_BASE_URL=
JANSATHI_EMBED_TOKEN=
JANSATHI_EMBED_MODEL=intfloat/multilingual-e5-small

# Server speech at /api/v1/speech/* through the same service. none = browser speech only.
JANSATHI_SPEECH_PROVIDER=none
JANSATHI_SPEECH_BASE_URL=
JANSATHI_SPEECH_TOKEN=

# The ML service itself (docker compose --profile ml). See ml/README.md for the licences:
# the voices and the default translator are non-commercial.
ML_SERVICE_TOKEN=
ML_MODELS_DIR=./ml/.models
# Only for gated models (IndicTrans2).
HF_TOKEN=

# The AI (Saathi and the assistant). Google Gemini through its OpenAI-compatible endpoint:
#   1. Create an API key at https://aistudio.google.com/ (Get API key).
#   2. Pick a current Gemini model id from the AI Studio model list (a Flash model is fast and cheap).
JANSATHI_LLM_PROVIDER=openai-compatible
JANSATHI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
JANSATHI_LLM_API_KEY=
JANSATHI_LLM_MODEL=
